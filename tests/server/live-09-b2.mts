import assert from "node:assert/strict";
import { loadEnvFile } from "node:process";
import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { ExploreState } from "../../src/shared/contracts";
import { HomeRequestV2, HomeResponseV2, CitiesRequestV2, CitiesResponseV2 } from "../../src/shared/contracts-09";
import { homeV2, matchSignatures, resolveSourceSignature } from "../../src/server/engine/09/home-api";
import { areaSignature, signatureReference, signatureSimilarity, targetSignatures } from "../../src/server/engine/09/signatures";
import { citiesV2 } from "../../src/server/engine/09/comparison";
import { cityManifest } from "../../src/server/engine/09/manifest";
import { haversine, median } from "../../src/server/engine/geo";
import { overlapShare } from "../../src/server/engine/09/geometry";
import { withQlooBudget } from "../../src/server/qloo/budget";
import { installPrivateCapture } from "../qloo/private-capture-09";

loadEnvFile(".env.local");
const capture = installPrivateCapture(process.argv.includes("--frozen"));
const profiles = JSON.parse(readFileSync(join(capture.directory, "profiles.json"), "utf8"));
const state = ExploreState.parse({ city: "Lisbon", loves: profiles.find((p: { name: string }) => p.name === "indie outdoors").loves });
let referenceCharges = 0; const refStart = performance.now();
const reference = await withQlooBudget(96, () => signatureReference(), n => { referenceCharges = n; });
const refReport = { version: reference.version, complete: reference.complete, elapsedMs: performance.now() - refStart, charges: referenceCharges, cities: [...reference.manifests].map(([id, manifest]) => ({ name: manifest.cityName, areas: manifest.areas.length, supported: reference.citySignatures.get(id)!.filter(s => s.quality === "sufficient").length, styleTerms: reference.styleIdf.size, musicTerms: reference.musicIdf.size })) };
console.log(JSON.stringify({ reference: refReport }));
const input = HomeRequestV2.parse({ responseVersion: 2, state, stateRevision: 11, source: { city: "Lisbon", neighborhood: "Alfama" }, lambda: 0 });
const started = performance.now(); let charges = 0;
const home = HomeResponseV2.parse(await withQlooBudget(96, () => homeV2(input), n => { charges = n; }));
const identityReport = { elapsedMs: performance.now() - started, charges, source: home.sourceSignatureSummary, top3: home.matches.slice(0, 3).map(m => ({ name: m.area.area.name, id: m.area.area.id, center: m.area.area.center, similarity: m.similarity, features: m.sharedFeatures.map(f => f.label) })) };
console.log(JSON.stringify({ identity: { elapsedMs: identityReport.elapsedMs, charges, source: { name: home.sourceSignatureSummary.area.name, support: home.sourceSignatureSummary.support, venueCount: home.sourceSignatureSummary.venueCount, categoryCounts: home.sourceSignatureSummary.categoryCounts }, top3: identityReport.top3 } }));
assert(home.matches[0].area.area.id === home.sourceSignatureSummary.area.id, "Canonical source must rank itself first");
assert(Math.abs(home.matches[0].similarity.value! - 100) < .1, "Canonical identity overlap must be 100");
assert(home.matches.every((m, i) => i === 0 || (home.matches[i - 1].similarity.value ?? -1) >= (m.similarity.value ?? -1)), "Home sorting must match S");
const source = await resolveSourceSignature(input.source);
const targets = await targetSignatures((await cityManifest("Lisbon")).value, reference);
const holdouts = [];
for (let offset = 0; offset < 5; offset++) {
  const kept = source.places.filter((_, i) => i % 5 !== offset);
  const manifest = { ...source.manifest, version: `${source.manifest.version}:holdout:${offset}`, catalog: kept };
  const variant = await areaSignature(manifest, { ...source.area, venueIds: kept.map(p => p.id) }, { enrich: false });
  const matched = matchSignatures(variant, targets, reference, home.matches[0].similarity.method);
  const nearby = matched.slice(0, 3).find(m => haversine(m.area.area.center, source.area.identity.center) <= 800 || overlapShare(m.area.area, source.area.identity) >= .5);
  const self = signatureSimilarity(variant, source, reference, home.matches[0].similarity.method);
  holdouts.push({ offset, kept: kept.length, self, nearby: nearby?.area.area.name, top3: matched.slice(0, 3).map(m => ({ name: m.area.area.name, value: m.similarity.value })) });
}
console.log(JSON.stringify({ holdouts, medianSelf: median(holdouts.map(h => h.self ?? 0)) }));
const before = JSON.stringify(state);
const comparisonInput = CitiesRequestV2.parse({ state, stateRevision: 11, cities: ["Lisbon", "Reykjavík"], source: { city: "Berlin", neighborhood: "Kreuzberg" }, criteria: ["home_similarity", "everyday_venues", "support"] });
const comparisonStart = performance.now();
const comparison = CitiesResponseV2.parse(await citiesV2(comparisonInput));
const comparisonMs = performance.now() - comparisonStart;
const three = CitiesResponseV2.parse(await citiesV2({ ...comparisonInput, cities: ["Lisbon", "Reykjavík", "Berlin"] }));
for (const city of comparison.results) assert.equal(three.results.find(c => c.cityId === city.cityId)?.culturalOverlap, city.culturalOverlap);
const invalid = CitiesResponseV2.parse(await citiesV2({ ...comparisonInput, cities: ["Lisbon", "Berlin", "Atlantiszzzz"] }));
assert.equal(invalid.results.filter(c => c.status === "error").length, 1);
assert.equal(JSON.stringify(state), before);
const comparisonReport = { elapsedMs: comparisonMs, method: comparison.method, referenceVersion: comparison.referenceVersion, results: comparison.results.map(r => ({ city: r.cityName, support: r.support, overlap: r.culturalOverlap, top3: r.homeMatches?.map(m => ({ name: m.area.area.name, value: m.similarity.value, features: m.sharedFeatures.map(f => f.label) })), categories: r.eligibleCategories })), recommendation: comparison.recommendation, invalid: invalid.results.map(c => ({ city: c.cityName, status: c.status })), thirdCityInvariant: true, selectedCityUnchanged: true };
console.log(JSON.stringify({ comparison: comparisonReport }));
writeFileSync(join(capture.directory, "b2-reference.json"), JSON.stringify({ refReport, identityReport, holdouts, comparisonReport, capture: capture.counts() }, null, 2));
capture.restore();
